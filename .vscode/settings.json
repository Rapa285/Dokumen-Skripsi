{
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.recipes": [
    {
      "name": "latex_itb_ta Thesis",
      "tools": [
        "latex_itb_make_thesis",
        "latex_itb_move_thesis"
      ]
    },
    {
      "name": "latex_itb_ta Yudisium",
      "tools": [
        "latex_itb_make_yudisium",
        "latex_itb_move_yudisium"
      ]
    },
    {
      "name": "latex_itb_ta Paper",
      "tools": [
        "latex_itb_make_paper",
        "latex_itb_move_paper"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "latex_itb_make_thesis",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-bibtex",
        "-outdir=..\\build",
        "-cd",
        "%DIR%\\thesis.tex"
      ],
      "env": {}
    },
    {
      "name": "latex_itb_make_yudisium",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-bibtex",
        "-outdir=..\\build",
        "-cd",
        "%DIR%\\yudisium.tex"
      ],
      "env": {}
    },
    {
      "name": "latex_itb_make_paper",
      "command": "latexmk",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-pdf",
        "-bibtex",
        "-outdir=..\\build",
        "-cd",
        "%DIR%\\paper.tex"
      ],
      "env": {}
    },
    {
      "name": "latex_itb_move_thesis",
      "command": "copy",
      "args": ["%OUTDIR%\\thesis.pdf", "%DIR%\\..\\output\\thesis.pdf"],
      "env": {}
    },
    {
      "name": "latex_itb_move_yudisium",
      "command": "copy",
      "args": [
        "%OUTDIR%\\yudisium.pdf",
        "%DIR%\\..\\output\\yudisium.pdf"
      ],
      "env": {}
    },
    {
      "name": "latex_itb_move_paper",
      "command": "copy",
      "args": [
        "%OUTDIR%\\paper.pdf",
        "%DIR%\\..\\output\\paper.pdf"
      ],
      "env": {}
    }
  ],
  "latex-workshop.synctex.afterBuild.enabled": true,
  "latex-workshop.latex.outDir": "%DIR%\\..\\build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/*.bak*": true,
  },
  "[latex]": {
    "editor.wordWrap": "on"
  }
}